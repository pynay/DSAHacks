# EyePop.ai credentials for the drone vision bridge (scripts/eyepop_bridge.py).
# Get a key at https://dashboard.eyepop.ai/dashboard
EYEPOP_API_KEY=eyp_your_key_here
EYEPOP_URL=https://compute.eyepop.ai
# Optional overrides:
# EYEPOP_BRIDGE_PORT=8091
# CAMERA_INDEX=0
# Optional: run on a video file/URL instead of the webcam (loops). Handy when camera access is blocked.
# VIDEO_SOURCE=/path/to/people.mp4
