# Mapbox public token for the delivery map (client-side; safe to expose).
# Get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# EyePop.ai vision (Food Check). Secret key — keep server-side, never commit the real value.
EYEPOP_SECRET_KEY=eyp_your_secret_key_here
# Optional: a food-freshness VLM ability UUID (created in the EyePop dashboard) for fresh/spoiled verdicts.
# EYEPOP_FOOD_ABILITY_UUID=your_ability_uuid

# --- Snowflake (durable evidence / feature / forecast / audit layer) ---
# Server-side only. Set the real values in .env.local (gitignored), never commit them.
# Account identifier is <org>-<account> from your Snowflake URL
#   e.g. app.snowflake.com/nsansdr/hmb04250  ->  SNOWFLAKE_ACCOUNT=nsansdr-hmb04250
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USERNAME=your_user
# Auth: EITHER a password/programmatic-access-token…
SNOWFLAKE_PASSWORD=your_password_or_pat
# …OR key-pair auth (recommended for programmatic access): point at your private key instead of the password.
# SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase
SNOWFLAKE_WAREHOUSE=PARSEL_WH
SNOWFLAKE_DATABASE=PARSEL
SNOWFLAKE_SCHEMA=CORE
# SNOWFLAKE_ROLE=ACCOUNTADMIN
